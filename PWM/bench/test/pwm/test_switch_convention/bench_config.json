{
  "name": "pwm_switch_convention",
  "python": "python",
  "script": "../Test_SPIN_API/scripts/test_pwm_switch_convention.py",
  "args": [
    { "flag": "--cut-port", "env": "BENCH_CUT_PORT", "default": "COM22" },
    { "flag": "--mux-port", "env": "BENCH_MUX_PORT", "default": "COM20" },
    { "flag": "--all-pwm-units", "env": "BENCH_SWITCH_ALL_PWM_UNITS", "default": "true" },
    { "flag": "--unit", "env": "BENCH_SWITCH_UNIT", "default": "A" },
    { "flag": "--channel", "env": "BENCH_SWITCH_CHANNEL", "default": "ch1" },
    { "flag": "--freq", "env": "BENCH_SWITCH_FREQ", "default": "1000" },
    { "flag": "--duty", "env": "BENCH_SWITCH_DUTY", "default": "0.30" },
    { "flag": "--convention", "env": "BENCH_SWITCH_CONVENTION", "default": "both" },
    { "flag": "--settle-seconds", "env": "BENCH_SWITCH_SETTLE_SECONDS", "default": "0.2" },
    { "flag": "--averages", "env": "BENCH_SWITCH_AVERAGES", "default": "3" },
    { "flag": "--trigger-edge-level", "env": "BENCH_SWITCH_TRIGGER_EDGE_LEVEL", "default": "1.5" },
    { "flag": "--timebase-scale", "env": "BENCH_SWITCH_TIMEBASE_SCALE" },
    { "flag": "--duty-tol-pct", "env": "BENCH_SWITCH_DUTY_TOL_PCT", "default": "1.0" }
  ]
}
