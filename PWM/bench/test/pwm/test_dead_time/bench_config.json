{
  "name": "pwm_dead_time",
  "python": "python",
  "script": "../Test_SPIN_API/scripts/test_pwm_dead_time.py",
  "args": [
    { "flag": "--cut-port", "env": "BENCH_CUT_PORT", "default": "COM22" },
    { "flag": "--mux-port", "env": "BENCH_MUX_PORT", "default": "COM20" },
    { "flag": "--all-complementary-pairs", "env": "BENCH_DEAD_TIME_ALL_COMPLEMENTARY", "default": "true" },
    { "flag": "--cut-pin-a", "env": "BENCH_DEAD_TIME_CUT_PIN_A", "default": "PA8" },
    { "flag": "--cut-pin-b", "env": "BENCH_DEAD_TIME_CUT_PIN_B", "default": "PA9" },
    { "flag": "--channel-a", "env": "BENCH_DEAD_TIME_CHANNEL_A", "default": "ch1" },
    { "flag": "--channel-b", "env": "BENCH_DEAD_TIME_CHANNEL_B", "default": "ch2" },
    { "flag": "--freq", "env": "BENCH_DEAD_TIME_FREQ", "default": "1000" },
    { "flag": "--duty", "env": "BENCH_DEAD_TIME_DUTY", "default": "0.50" },
    { "flag": "--dead-time-pct", "env": "BENCH_DEAD_TIME_PCT", "default": "1.0" },
    { "flag": "--expected-rfdelay-ns", "env": "BENCH_DEAD_TIME_EXPECTED_RF_NS" },
    { "flag": "--expected-frdelay-ns", "env": "BENCH_DEAD_TIME_EXPECTED_FR_NS" },
    { "flag": "--dead-rise-ns", "env": "BENCH_DEAD_TIME_RISE_NS" },
    { "flag": "--dead-fall-ns", "env": "BENCH_DEAD_TIME_FALL_NS" },
    { "flag": "--delay-tol-pct", "env": "BENCH_DEAD_TIME_TOL_PCT", "default": "20.0" },
    { "flag": "--settle-seconds", "env": "BENCH_DEAD_TIME_SETTLE_SECONDS", "default": "0.5" },
    { "flag": "--averages", "env": "BENCH_DEAD_TIME_AVERAGES", "default": "3" },
    { "flag": "--trigger-edge-level", "env": "BENCH_DEAD_TIME_TRIGGER_EDGE_LEVEL", "default": "1.5" },
    { "flag": "--timebase-scale", "env": "BENCH_DEAD_TIME_TIMEBASE_SCALE" }
  ]
}
