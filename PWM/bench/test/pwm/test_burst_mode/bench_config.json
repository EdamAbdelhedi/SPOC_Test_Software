{
  "name": "pwm_burst_mode",
  "python": "python",
  "script": "../Test_SPIN_API/scripts/test_pwm_burst_mode.py",
  "args": [
    { "flag": "--cut-port", "env": "BENCH_CUT_PORT", "default": "COM22" },
    { "flag": "--mux-port", "env": "BENCH_MUX_PORT", "default": "COM20" },
    { "flag": "--all-pwm-pins", "env": "BENCH_BURST_ALL_PWM_PINS", "default": "true" },
    { "flag": "--cut-pin", "env": "BENCH_BURST_CUT_PIN", "default": "PA8" },
