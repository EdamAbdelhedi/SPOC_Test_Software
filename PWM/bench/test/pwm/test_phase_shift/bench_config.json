{
  "name": "pwm_phase_shift",
  "python": "python",
  "script": "../Test_SPIN_API/scripts/test_pwm_phase_shift.py",
  "args": [
    { "flag": "--cut-port", "env": "BENCH_CUT_PORT", "default": "COM22" },
    { "flag": "--mux-port", "env": "BENCH_MUX_PORT", "default": "COM20" },
    { "flag": "--all-main-pairs", "env": "BENCH_PHASE_ALL_MAIN_PAIRS", "default": "true" },
    { "flag": "--cut-pin-a", "env": "BENCH_PHASE_CUT_PIN_A", "default": "PA8" },
    { "flag": "--cut-pin-b", "env": "BENCH_PHASE_CUT_PIN_B", "default": "PB12" },
    { "flag": "--channel-a", "env": "BENCH_PHASE_CHANNEL_A", "default": "ch1" },
    { "flag": "--channel-b", "env": "BENCH_PHASE_CHANNEL_B", "default": "ch2" },
    { "flag": "--freq", "env": "BENCH_PHASE_FREQ", "default": "1000" },
    { "flag": "--duty", "env": "BENCH_PHASE_DUTY", "default": "0.50" },
    { "flag": "--phase-deg", "env": "BENCH_PHASE_DEG", "default": "45" },
    { "flag": "--phase-tol-deg", "env": "BENCH_PHASE_TOL_DEG", "default": "5" },
    { "flag": "--settle-seconds", "env": "BENCH_PHASE_SETTLE_SECONDS", "default": "0.1" },
    { "flag": "--averages", "env": "BENCH_PHASE_AVERAGES", "default": "3" },
    { "flag": "--trigger-edge-level", "env": "BENCH_PHASE_TRIGGER_EDGE_LEVEL", "default": "1.5" },
    { "flag": "--timebase-scale", "env": "BENCH_PHASE_TIMEBASE_SCALE" }
  ]
}
