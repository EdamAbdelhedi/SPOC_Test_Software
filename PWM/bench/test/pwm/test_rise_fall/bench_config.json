{
  "name": "pwm_rise_fall",
  "python": "python",
  "script": "../Test_SPIN_API/scripts/test_pwm_rise_fall.py",
  "args": [
    { "flag": "--cut-port", "env": "BENCH_CUT_PORT", "default": "COM22" },
    { "flag": "--mux-port", "env": "BENCH_MUX_PORT", "default": "COM20" },
    { "flag": "--all-pwm-pins", "env": "BENCH_RISE_FALL_ALL_PWM_PINS", "default": "true" },
    { "flag": "--cut-pin", "env": "BENCH_RISE_FALL_CUT_PIN", "default": "PA8" },
    { "flag": "--channel", "env": "BENCH_RISE_FALL_CHANNEL", "default": "ch1" },
    { "flag": "--freq", "env": "BENCH_RISE_FALL_FREQ", "default": "1000" },
    { "flag": "--duty", "env": "BENCH_RISE_FALL_DUTY", "default": "0.50" },
    { "flag": "--settle-seconds", "env": "BENCH_RISE_FALL_SETTLE_SECONDS", "default": "0.1" },
    { "flag": "--averages", "env": "BENCH_RISE_FALL_AVERAGES", "default": "3" },
    { "flag": "--trigger-edge-level", "env": "BENCH_RISE_FALL_TRIGGER_EDGE_LEVEL", "default": "1.5" },
    { "flag": "--timebase-scale", "env": "BENCH_RISE_FALL_TIMEBASE_SCALE" },
    { "flag": "--rise-max-ns", "env": "BENCH_RISE_FALL_RISE_MAX_NS", "default": "200" },
    { "flag": "--fall-max-ns", "env": "BENCH_RISE_FALL_FALL_MAX_NS", "default": "200" }
  ]
}
